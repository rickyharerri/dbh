# Copy to .env for local development. .env is git-ignored. NEVER commit real values.
# On Databricks Apps these come from app.yaml / app resources instead (the app's service principal is injected).

# ---------- Databricks connection (read server-side only; never sent to the browser) ----------
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=<sql-warehouse-id>
# Local auth: a personal access token OR OAuth M2M (DATABRICKS_CLIENT_ID/DATABRICKS_CLIENT_SECRET) OR a CLI profile.
DATABRICKS_TOKEN=<token>

# ---------- Genie (optional; Ask AquaWise shows "AI assistant not configured" without it) ----------
GENIE_SPACE_ID=<genie-space-id>

# ---------- Where the data lives ----------
DATABRICKS_CATALOG=calgary_agent_hackathon
DATABRICKS_SCHEMA=alberta_water_well_data

# ---------- Schema mapping: fill in AFTER running scripts/discover_schema.py ----------
# Required (the app reports exactly which of these are missing):
WELLS_TABLE=
WELLS_COL_ID=
WELLS_COL_LATITUDE=
WELLS_COL_LONGITUDE=
# Optional — leave blank and the matching card/column shows "Not available":
WELLS_COL_DEPTH=
WELLS_COL_YIELD=
WELLS_COL_STATIC_WATER_LEVEL=
WELLS_COL_DRILL_DATE=
WELLS_COL_STATUS=
# Units are facts about the source data. Set what the data dictionary says; they are never guessed:
WELLS_DEPTH_UNIT=
WELLS_YIELD_UNIT=
WELLS_STATIC_WATER_LEVEL_UNIT=
# Low-yield records are counted below this value, in WELLS_YIELD_UNIT. Blank = not shown.
LOW_YIELD_THRESHOLD=

# Water quality (long format: one row per well × parameter × sample). Blank = Water Quality shows "not available".
QUALITY_TABLE=
QUALITY_COL_WELL_ID=
QUALITY_COL_PARAMETER=
QUALITY_COL_VALUE=
QUALITY_COL_UNIT=
QUALITY_COL_SAMPLE_DATE=
# Optional versioned guideline reference (see backend/data/guidelines.example.json). Blank = "Not evaluated".
QUALITY_GUIDELINES_FILE=

# ---------- Optional ----------
# Place-name search: any Nominatim-compatible /search URL. Blank = search box hidden.
GEOCODER_URL=
# Explicit opt-in to SYNTHETIC demo fixtures (no Databricks needed). Never use for real findings.
AQUAWISE_DEMO_MODE=false
# Tuning
CACHE_TTL_SECONDS=300
DB_POOL_SIZE=4
QUERY_TIMEOUT_SECONDS=30
GENIE_TIMEOUT_SECONDS=90
HIST_BINS=10
HIST_DEPTH_BIN=25
HIST_YIELD_BIN=5
MIN_SAMPLE_SIZE=5
# Only when running the Vite dev server on another port:
CORS_ORIGINS=http://localhost:5173
